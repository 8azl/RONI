            local previousSlash =
                getSwordSlashName(previousSword)

            local swordKey =
                normalizeSwordEffectName(previousSword)

            local slashKey =
                normalizeSwordEffectName(previousSlash)

            local function belongsToOldSword(object)
                if not object then return false end

                local nameKey =
                    normalizeSwordEffectName(object.Name)

                if swordKey ~= ""
                    and nameKey:find(swordKey, 1, true) then
                    return true
                end

                if slashKey ~= ""
                    and slashKey ~= "slasheffect"
                    and nameKey:find(slashKey, 1, true) then
