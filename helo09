            local page =
                ShopController._inventoryPages
                and ShopController._inventoryPages[inventoryType]

            if not page then
                return
            end

            pcall(function()
                page.BeginBatch()
            end)

            local items =
                ShopController._virtualItems
                and ShopController._virtualItems[inventoryType]

            if items and page.MarkDirty then
                for _, item in pairs(items) do
                    pcall(function()
                        page.MarkDirty(item, true, true)
                    end)
                end

                pcall(function()
                    page.MarkDirty(nil, true, true)
                end)
            end

            pcall(function()
