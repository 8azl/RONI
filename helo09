    Toggle = function(state)
        AvatarChanger.Enabled = (state == true)
        if AvatarChanger.Enabled then
            saveOriginalAppearance()
            if AvatarChanger.Target ~= "" then
                AvatarChanger.SetTarget(AvatarChanger.Target)
            end
        else
            restoreOriginalAppearance()
        end
    end,
}

