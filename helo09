            pcall(function()
                local equipFunction = Swords and (rawget(Swords, "EquipSwordTo") or Swords.EquipSwordTo)


                if type(equipFunction) == "function"
                    and getupvalues
                    and setupvalue then

                    pcall(function()
                        setupvalue(equipFunction, 3, false)
                    end)

                    local upvalues = getupvalues(equipFunction)

                    for index, value in ipairs(upvalues) do
                        if type(value) == "boolean" then
                            setupvalue(equipFunction, index, false)
                            break
                        end
                    end
                end

                if Swords and Swords.EquipSwordTo then
                    Swords:EquipSwordTo(character, swordName)
                end
            end)


            local controller =
                VisualNativeUnlockAll.SwordController
                or findSwordControllerOnce()

            if controller then
                pcall(function()
                    if type(controller.SetSword) == "function" then
                        controller:SetSword(swordName)
                    end
                end)


                pcall(function()
                    if controller.currentSword ~= nil then
                        controller.currentSword = swordName
                    end
                end)

                pcall(function()
                    if controller.SwordFX ~= nil then
                        controller.SwordFX = swordName
                    end
                end)
