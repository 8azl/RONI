                    "Sword",
                    "SwordName",
                    "SwordFX",
                    "Effect",
                    "EffectName",
                    "SlashName",
                }) do
                    local value = object:GetAttribute(attributeName)

                    if type(value) == "string" then
                        local key =
                            normalizeSwordEffectName(value)

                        if key == swordKey
                            or (
                                slashKey ~= ""
                                and slashKey ~= "slasheffect"
