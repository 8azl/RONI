local function normalizeName(val)
    return tostring(val or ""):lower():gsub("[^%w]", "")
end

local function attachAccessoryManually(char, acc)
    local handle = acc:FindFirstChild("Handle")
    if not handle or not handle:IsA("BasePart") then return end

    local accAttachment = handle:FindFirstChildOfClass("Attachment")
    local charAttachment

    if accAttachment then
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                charAttachment = part:FindFirstChild(accAttachment.Name)
                if charAttachment then break end
            end
        end
    end

    local r6AttachmentOffsets = {
        ["HatAttachment"] = {Part = "Head", CFrame = CFrame.new(0, 0.6, 0)},
        ["HairAttachment"] = {Part = "Head", CFrame = CFrame.new(0, 0.6, 0)},
        ["FaceFrontAttachment"] = {Part = "Head", CFrame = CFrame.new(0, 0, -0.6)},
        ["FaceCenterAttachment"] = {Part = "Head", CFrame = CFrame.new(0, 0, -0.6)},
        ["NeckAttachment"] = {Part = "Torso", CFrame = CFrame.new(0, 1, 0)},
        ["BackAttachment"] = {Part = "Torso", CFrame = CFrame.new(0, 0, 0.6)},
        ["BodyBackAttachment"] = {Part = "Torso", CFrame = CFrame.new(0, 0, 0.6)},
        ["WaistAttachment"] = {Part = "Torso", CFrame = CFrame.new(0, -1, 0)},
        ["BodyWaistAttachment"] = {Part = "Torso", CFrame = CFrame.new(0, -1, 0)},
        ["LeftCollarAttachment"] = {Part = "Torso", CFrame = CFrame.new(-0.6, 1, 0)},
        ["RightCollarAttachment"] = {Part = "Torso", CFrame = CFrame.new(0.6, 1, 0)},
        ["LeftShoulderAttachment"] = {Part = "Torso", CFrame = CFrame.new(-1, 1, 0)},
        ["RightShoulderAttachment"] = {Part = "Torso", CFrame = CFrame.new(1, 1, 0)},
    }

    if charAttachment then
        acc.Parent = char
        handle.CanCollide = false
        handle.Anchored = false

        local part = charAttachment.Parent
        if charAttachment:IsA("Attachment") and accAttachment then
            handle.CFrame = part.CFrame * charAttachment.CFrame * accAttachment.CFrame:Inverse()
        else
            handle.CFrame = part.CFrame * CFrame.new(0, 0.6, 0)
        end

        local weld = Instance.new("Weld")
        weld.Name = "AccessoryWeld"
        weld.Part0 = handle
        weld.Part1 = part
        weld.C0 = accAttachment and accAttachment.CFrame or CFrame.new(0, 0.6, 0)
        weld.C1 = charAttachment:IsA("Attachment") and charAttachment.CFrame or CFrame.new()
        weld.Parent = handle
    else
        local partName = "Head"
        local offset = CFrame.new(0, 0.6, 0)

        if accAttachment then
            local targetOffset = r6AttachmentOffsets[accAttachment.Name]
            if targetOffset then
                partName = targetOffset.Part
                offset = targetOffset.CFrame
            end
        end

        local part = char:FindFirstChild(partName)
        if part then
            acc.Parent = char
            handle.CanCollide = false
            handle.Anchored = false

            if accAttachment then
                handle.CFrame = part.CFrame * offset * accAttachment.CFrame:Inverse()
            else
                handle.CFrame = part.CFrame * offset
            end

            local weld = Instance.new("Weld")
            weld.Name = "AccessoryWeld"
            weld.Part0 = handle
            weld.Part1 = part
            weld.C0 = accAttachment and accAttachment.CFrame or offset
            weld.C1 = offset
            weld.Parent = handle
        else
            acc.Parent = char
        end
    end
end

Cosmetics.AvatarChanger = {
    Enabled = false,
    Target = "",
    OriginalAppearance = nil
}

function Cosmetics.AvatarChanger.SaveAppearance()
    if Cosmetics.AvatarChanger.OriginalAppearance then return end
    local char = LocalPlayer.Character
    if not char then return end

    local appearance = {
        Face = nil,
        Shirt = nil,
        Pants = nil,
        BodyColors = nil,
        HeadMesh = nil,
        Accessories = {},
        CharacterMeshes = {}
    }

    local head = char:FindFirstChild("Head")
    if head then
        local face = head:FindFirstChildOfClass("Decal")
        if face then
            appearance.Face = face.Texture
        end
        local headMesh = head:FindFirstChildOfClass("SpecialMesh")
        if headMesh then
            appearance.HeadMesh = headMesh:Clone()
        end
    end

    local shirt = char:FindFirstChildOfClass("Shirt")
    if shirt then
        appearance.Shirt = shirt.ShirtTemplate
    end

    local pants = char:FindFirstChildOfClass("Pants")
    if pants then
        appearance.Pants = pants.PantsTemplate
    end

    local bc = char:FindFirstChildOfClass("BodyColors")
    if bc then
        appearance.BodyColors = {
            HeadColor3 = bc.HeadColor3,
            LeftArmColor3 = bc.LeftArmColor3,
            RightArmColor3 = bc.RightArmColor3,
            LeftLegColor3 = bc.LeftLegColor3,
            RightLegColor3 = bc.RightLegColor3,
            TorsoColor3 = bc.TorsoColor3
        }
    end

    for _, obj in ipairs(char:GetChildren()) do
        if obj:IsA("Accessory") or obj:IsA("Accoutrement") then
            table.insert(appearance.Accessories, obj:Clone())
        elseif obj:IsA("CharacterMesh") then
            table.insert(appearance.CharacterMeshes, obj:Clone())
        end
    end

    Cosmetics.AvatarChanger.OriginalAppearance = appearance
end

function Cosmetics.AvatarChanger.RestoreAppearance()
    local char = LocalPlayer.Character
    local orig = Cosmetics.AvatarChanger.OriginalAppearance
    if not char or not orig then return end

    pcall(function()
        for _, obj in ipairs(char:GetChildren()) do
            if obj:IsA("Accessory") or obj:IsA("Accoutrement") or obj:IsA("Shirt") or obj:IsA("Pants") or obj:IsA("BodyColors") or obj:IsA("CharacterMesh") or obj:IsA("ShirtGraphic") then
                obj:Destroy()
            end
        end

        local head = char:FindFirstChild("Head")
        if head then
            local face = head:FindFirstChildOfClass("Decal")
            if face then face:Destroy() end
            if orig.Face then
                local newFace = Instance.new("Decal")
                newFace.Name = "face"
                newFace.Texture = orig.Face
                newFace.Parent = head
            end

            local headMesh = head:FindFirstChildOfClass("SpecialMesh")
            if headMesh then headMesh:Destroy() end
            if orig.HeadMesh then
                orig.HeadMesh:Clone().Parent = head
            end
        end

        if orig.Shirt then
            local shirt = Instance.new("Shirt")
            shirt.Name = "Shirt"
            shirt.ShirtTemplate = orig.Shirt
            shirt.Parent = char
        end

        if orig.Pants then
            local pants = Instance.new("Pants")
            pants.Name = "Pants"
            pants.PantsTemplate = orig.Pants
            pants.Parent = char
        end

        if orig.BodyColors then
            local bc = Instance.new("BodyColors")
            bc.HeadColor3 = orig.BodyColors.HeadColor3
            bc.LeftArmColor3 = orig.BodyColors.LeftArmColor3
            bc.RightArmColor3 = orig.BodyColors.RightArmColor3
            bc.LeftLegColor3 = orig.BodyColors.LeftLegColor3
            bc.RightLegColor3 = orig.BodyColors.RightLegColor3
            bc.TorsoColor3 = orig.BodyColors.TorsoColor3
            bc.Parent = char
        end

        for _, mesh in ipairs(orig.CharacterMeshes) do
            mesh:Clone().Parent = char
        end

        for _, acc in ipairs(orig.Accessories) do
            pcall(function()
                attachAccessoryManually(char, acc:Clone())
            end)
        end
    end)
end

function Cosmetics.AvatarChanger.Apply(userId)
    local char = LocalPlayer.Character
    if not char then return end

    local success, model = pcall(function()
        return Players:CreateHumanoidModelFromUserId(userId)
    end)
    if not success or not model then return end

    pcall(function()
        for _, obj in ipairs(char:GetChildren()) do
            if obj:IsA("Accessory") or obj:IsA("Accoutrement") or obj:IsA("Shirt") or obj:IsA("Pants") or obj:IsA("BodyColors") or obj:IsA("CharacterMesh") or obj:IsA("ShirtGraphic") then
                obj:Destroy()
            end
        end

        local head = char:FindFirstChild("Head")
        local modelHead = model:FindFirstChild("Head")
        if head and modelHead then
            local face = head:FindFirstChildOfClass("Decal")
            if face then face:Destroy() end

            local modelFace = modelHead:FindFirstChildOfClass("Decal")
            if modelFace then
                modelFace:Clone().Parent = head
            end

            local headMesh = head:FindFirstChildOfClass("SpecialMesh")
            local modelMesh = modelHead:FindFirstChildOfClass("SpecialMesh")
            if modelMesh then
                if headMesh then headMesh:Destroy() end
                modelMesh:Clone().Parent = head
            elseif headMesh then
                headMesh:Destroy()
            end

            head.Size = modelHead.Size
            head.Color = modelHead.Color
        end

        for _, obj in ipairs(model:GetChildren()) do
            if obj:IsA("Shirt") or obj:IsA("Pants") or obj:IsA("BodyColors") or obj:IsA("ShirtGraphic") or obj:IsA("CharacterMesh") then
                obj:Clone().Parent = char
            elseif obj:IsA("Accessory") or obj:IsA("Accoutrement") then
                pcall(function()
                    attachAccessoryManually(char, obj:Clone())
                end)
            end
        end

        model:Destroy()
    end)
end

function Cosmetics.AvatarChanger.SetTarget(target)
    Cosmetics.AvatarChanger.Target = tostring(target or "")
    if Cosmetics.AvatarChanger.Enabled and Cosmetics.AvatarChanger.Target ~= "" then
        local targetId = tonumber(Cosmetics.AvatarChanger.Target)
        if not targetId then
            pcall(function()
                targetId = Players:GetUserIdFromNameAsync(Cosmetics.AvatarChanger.Target)
            end)
        end
        if targetId then
            Cosmetics.AvatarChanger.Apply(targetId)
        end
    end
end

function Cosmetics.AvatarChanger.Toggle(state)
    Cosmetics.AvatarChanger.Enabled = state == true
    if Cosmetics.AvatarChanger.Enabled then
        Cosmetics.AvatarChanger.SaveAppearance()
        if Cosmetics.AvatarChanger.Target ~= "" then
            Cosmetics.AvatarChanger.SetTarget(Cosmetics.AvatarChanger.Target)
        end
    else
        Cosmetics.AvatarChanger.RestoreAppearance()
    end
end

