        local function getSwordDataByName(swordName)
            if type(swordName) ~= "string" or swordName == "" then
                return nil
            end

            if Swords then
                local ok, swordData =
                    pcall(function()
                        return Swords:GetSword(swordName)
                    end)

                if ok and swordData then
                    return swordData
                end
            end

            if visualUnlockCatalog and visualUnlockCatalog.SwordData and visualUnlockCatalog.SwordData[swordName] then
                return visualUnlockCatalog.SwordData[swordName]
            end

            return { Name = swordName, SlashName = swordName }
        end

        local function getSwordSlashName(swordName)
            local swordData = getSwordDataByName(swordName)

            if type(swordData) == "table"
                and type(swordData.SlashName) == "string"
                and swordData.SlashName ~= "" then
                return swordData.SlashName
            end

            return "SlashEffect"
        end

        local function normalizeSwordEffectName(value)
            return tostring(value or "")
                :lower()
                :gsub("[^%w]", "")
        end

        local function visualRemoveOldSwordCompletely(previousSword)
