Cosmetics.UnlockAll = {
    Enabled = false,
    Connections = {},
    HookedPages = {},
    OriginalSetItems = {},
    EquipButtonConnection = nil,
    LocalEquipButton = nil
}

local function stateSet(state, value)
    if state and type(state.Set) == "function" then
        pcall(function()
            state:Set(value)
        end)
    end
end

local function forceOwned(item)
    if type(item) ~= "table" then return false end
    item.Hidden = false
    item.ForceHide = false
    item.AlwaysVisible = true
    item.Section = "Owned"

    stateSet(item.OwnsItem, true)

    if item.ItemsMatching and type(item.ItemsMatching.Set) == "function" then
        local current = {}
        pcall(function()
            current = item.ItemsMatching:Get() or {}
        end)
        if #current == 0 then
            stateSet(item.ItemsMatching, {
                "__visual_unlock_" .. tostring(item.Name)
            })
        end
    end
    return true
end

local function findExistingVirtualItem(inventoryType, name)
    local sc = getShopController()
    if not sc or not sc._virtualItems or not sc._virtualItems[inventoryType] then
        return nil
    end
    local list = sc._virtualItems[inventoryType]
    if list[name] then return list[name] end
    for _, itm in pairs(list) do
        if type(itm) == "table" and itm.Name == name then
            return itm
        end
    end
    return nil
end

local function ensurePageLoaded(pageName)
    local sc = getShopController()
    if not sc then return end
    if type(sc._loadInventoryPage) == "function" then
        pcall(function()
            sc:_loadInventoryPage(pageName)
        end)
    end
    local deadline = os.clock() + 3
    while os.clock() < deadline do
        local page = sc._inventoryPages and sc._inventoryPages[pageName]
        local items = sc._virtualItems and sc._virtualItems[pageName]
        if page and items then break end
        task.wait(0.05)
    end
end

local function hookInventoryPageScroll(pageType)
    local sc = getShopController()
    if not sc or not sc._inventoryPages then return end
    local page = sc._inventoryPages[pageType]
    if not page or not page.Scroll or Cosmetics.UnlockAll.HookedPages[pageType] then return end

    local origSetItems = page.Scroll.SetItems
    Cosmetics.UnlockAll.OriginalSetItems[pageType] = origSetItems
    Cosmetics.UnlockAll.HookedPages[pageType] = true

    page.Scroll.SetItems = function(section, items)
        if Cosmetics.UnlockAll.Enabled then
            if section == "Unowned" then
                return origSetItems("Unowned", {})
            elseif section == "Owned" then
                local allOwned = {}
                local seen = {}
                local vItems = sc._virtualItems and sc._virtualItems[pageType]
                if vItems then
                    for _, itm in pairs(vItems) do
                        if type(itm) == "table" and itm.Name and not itm.ForceHide and not seen[itm.Name] then
                            seen[itm.Name] = true
                            forceOwned(itm)
                            table.insert(allOwned, itm)
                        end
                    end
                end
                return origSetItems("Owned", allOwned)
            end
        end
        return origSetItems(section, items)
    end
end

local function refreshInventoryPage(pageType)
    local sc = getShopController()
    if not sc or not sc._inventoryPages then return end
    local page = sc._inventoryPages[pageType]
    if not page then return end

    hookInventoryPageScroll(pageType)

    pcall(function()
        page.BeginBatch()
    end)

    local items = sc._virtualItems and sc._virtualItems[pageType]
    if items and page.MarkDirty then
        for _, itm in pairs(items) do
            if type(itm) == "table" then
                forceOwned(itm)
                pcall(function()
                    page.MarkDirty(itm, true, true)
                end)
            end
        end
        pcall(function()
            page.MarkDirty(nil, true, true)
        end)
    end

    pcall(function()
        page.EndBatch()
    end)
end

local function unlockSwords()
    local sc = getShopController()
    local sm = getSwordsModule()
    if not sc or not sm then return end

    ensurePageLoaded("Sword")

    sc._virtualItems = sc._virtualItems or {}
    sc._virtualItems.Sword = sc._virtualItems.Sword or {}

    local collection = sm:GetCollection()
    local processed = 0
    for key, sword in pairs(collection) do
        processed += 1
        if processed % 30 == 0 then
            task.wait()
        end
        if type(sword) == "table" then
            local swordName = sword.Name or (type(key) == "string" and key) or nil
            if swordName then
                local item = findExistingVirtualItem("Sword", swordName)
                if not item and type(sc._createSwordSlot) == "function" then
                    pcall(function()
                        sc:_createSwordSlot(sword)
                    end)
                    item = findExistingVirtualItem("Sword", swordName)
                end
                if item then
                    forceOwned(item)
                end
            end
        end
    end

    refreshInventoryPage("Sword")
end

local function unlockExplosions()
    local sc = getShopController()
    if not sc then return end

    ensurePageLoaded("Explosion")

    local misc = ReplicatedStorage:FindFirstChild("Misc")
    local dataExplosions = misc and misc:FindFirstChild("DataExplosions")
    if not dataExplosions then return end

    sc._virtualItems = sc._virtualItems or {}
    sc._virtualItems.Explosion = sc._virtualItems.Explosion or {}

    for _, config in ipairs(dataExplosions:GetChildren()) do
        local item = findExistingVirtualItem("Explosion", config.Name)
        if not item and type(sc._createExplosionSlot) == "function" then
            pcall(function()
                sc:_createExplosionSlot(config)
            end)
            item = findExistingVirtualItem("Explosion", config.Name)
        end
        if item then
            forceOwned(item)
        end
    end

    refreshInventoryPage("Explosion")
end

local function unlockTitles()
    for _, object in ipairs(PlayerGui:GetDescendants()) do
        if object:IsA("GuiObject") then
            local parent = object.Parent
            local grand = parent and parent.Parent
            local inTitleList = (parent and parent.Name == "TitleList") or (grand and grand.Name == "TitleList")
            if inTitleList and object:FindFirstChild("TextLabel") then
                object.Visible = true
            end
        end
    end
end

local function unlockEmotes()
    local misc = ReplicatedStorage:FindFirstChild("Misc")
    local emotes = misc and misc:FindFirstChild("Emotes")
    if emotes then
        for _, emote in ipairs(emotes:GetChildren()) do
            pcall(function()
                emote:SetAttribute("Unlocked", true)
            end)
        end
    end
end

local function getShopInfoParts()
    local shop = PlayerGui:FindFirstChild("Shop")
    local holder = shop and shop:FindFirstChild("Holder")
    local infoBG = holder and holder:FindFirstChild("InfoBG")
    if not infoBG then
        return shop, nil, nil, nil
    end
    local namer = infoBG:FindFirstChild("Namer")
    local buyButton = infoBG:FindFirstChild("BuyButton")
    return shop, infoBG, namer, buyButton
end

local function setButtonText(button, value)
    if not button then return end
    if button:IsA("GuiObject") then
        button.Visible = true
        button.Active = true
    end
    if button:IsA("TextButton") then
        button.Text = value
    end
    for _, object in ipairs(button:GetDescendants()) do
        if object:IsA("TextLabel") or object:IsA("TextButton") then
            local current = object.Text
            if current == "Buy" or current == "Equip" or current == "Equipped" or tostring(object.Name):lower():find("price", 1, true) or tostring(object.Name):lower():find("equip", 1, true) then
                object.Text = value
                object.Visible = true
            end
        end
    end
end

local function destroyLocalEquipButton()
    if Cosmetics.UnlockAll.EquipButtonConnection then
        Cosmetics.UnlockAll.EquipButtonConnection:Disconnect()
        Cosmetics.UnlockAll.EquipButtonConnection = nil
    end
    if Cosmetics.UnlockAll.LocalEquipButton and Cosmetics.UnlockAll.LocalEquipButton.Parent then
        pcall(function()
            Cosmetics.UnlockAll.LocalEquipButton:Destroy()
        end)
    end
    Cosmetics.UnlockAll.LocalEquipButton = nil
end

local function ensureLocalSwordEquipButton()
    if not Cosmetics.UnlockAll.Enabled then
        destroyLocalEquipButton()
        return
    end

    local shop, infoBG, namer, nativeButton = getShopInfoParts()
    if not shop or not infoBG or not namer or not namer:IsA("TextLabel") then
        return
    end

    local swordName = namer.Text
    local sm = getSwordsModule()
    if swordName == "" or not sm or not sm:GetSword(swordName) then
        destroyLocalEquipButton()
        return
    end

    local isEquipped = (Cosmetics.SwordChanger.EquippedSword == swordName)

    if nativeButton then
        setButtonText(nativeButton, isEquipped and "Equipped" or "Equip")
    end

    if Cosmetics.UnlockAll.LocalEquipButton and Cosmetics.UnlockAll.LocalEquipButton.Parent == infoBG then
        Cosmetics.UnlockAll.LocalEquipButton.Visible = true
        setButtonText(Cosmetics.UnlockAll.LocalEquipButton, isEquipped and "Equipped" or "Equip")
        return
    end

    destroyLocalEquipButton()

    local button
    if nativeButton and nativeButton:IsA("GuiButton") then
        button = nativeButton:Clone()
        button.Name = "CosmeticUnlockEquipButton"
        for _, object in ipairs(button:GetDescendants()) do
            if object:IsA("LocalScript") or object:IsA("Script") then
                object:Destroy()
            end
        end
        button.Parent = infoBG
        button.ZIndex = math.max(button.ZIndex + 10, 30)
    else
        button = Instance.new("TextButton")
        button.Name = "CosmeticUnlockEquipButton"
        button.Size = UDim2.new(0.82, 0, 0, 52)
        button.Position = UDim2.new(0.09, 0, 1, -68)
        button.BackgroundColor3 = Color3.fromRGB(70, 190, 60)
        button.BorderSizePixel = 0
        button.Text = "Equip"
        button.Font = Enum.Font.GothamBold
        button.TextSize = 22
        button.TextColor3 = Color3.new(1, 1, 1)
        button.ZIndex = 30
        button.Parent = infoBG

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 8)
        corner.Parent = button
    end

    button.Visible = true
    button.Active = true
    Cosmetics.UnlockAll.LocalEquipButton = button

    setButtonText(button, isEquipped and "Equipped" or "Equip")

    Cosmetics.UnlockAll.EquipButtonConnection = button.Activated:Connect(function()
        local currentSword = namer.Text
        if Cosmetics.SwordChanger.Equip(currentSword) then
            setButtonText(button, "Equipped")
            if nativeButton then
                setButtonText(nativeButton, "Equipped")
            end
        end
    end)
end

local function hookShopEvents()
    local shop = PlayerGui:FindFirstChild("Shop")
    if not shop then return end

    table.insert(Cosmetics.UnlockAll.Connections, shop:GetPropertyChangedSignal("Enabled"):Connect(function()
        if Cosmetics.UnlockAll.Enabled and shop.Enabled then
            task.defer(function()
                refreshInventoryPage("Sword")
                refreshInventoryPage("Explosion")
                ensureLocalSwordEquipButton()
            end)
        end
    end))

    local holder = shop:FindFirstChild("Holder")
    local infoBG = holder and holder:FindFirstChild("InfoBG")
    local namer = infoBG and infoBG:FindFirstChild("Namer")

    if namer then
        table.insert(Cosmetics.UnlockAll.Connections, namer:GetPropertyChangedSignal("Text"):Connect(function()
            if Cosmetics.UnlockAll.Enabled then
                task.defer(ensureLocalSwordEquipButton)
            end
        end))
    end

    if infoBG then
        table.insert(Cosmetics.UnlockAll.Connections, infoBG:GetPropertyChangedSignal("Visible"):Connect(function()
            if Cosmetics.UnlockAll.Enabled and infoBG.Visible then
                task.defer(ensureLocalSwordEquipButton)
            end
        end))
    end
end

function Cosmetics.UnlockAll.Enable()
    if Cosmetics.UnlockAll.Enabled then return end
    Cosmetics.UnlockAll.Enabled = true

    unlockSwords()
    unlockExplosions()
    unlockTitles()
    unlockEmotes()
    hookShopEvents()
    task.defer(ensureLocalSwordEquipButton)
end

function Cosmetics.UnlockAll.Disable()
    Cosmetics.UnlockAll.Enabled = false

    for _, conn in ipairs(Cosmetics.UnlockAll.Connections) do
        pcall(function() conn:Disconnect() end)
    end
    table.clear(Cosmetics.UnlockAll.Connections)

    destroyLocalEquipButton()

    local sc = getShopController()
    if sc and sc._inventoryPages then
        for pageType, page in pairs(sc._inventoryPages) do
            if page and page.MarkDirty then
                pcall(function()
                    page.MarkDirty(nil, true, true)
                end)
            end
        end
    end
end

function Cosmetics.UnlockAll.Toggle(state)
    if state then
        Cosmetics.UnlockAll.Enable()
    else
        Cosmetics.UnlockAll.Disable()
    end
end

function Cosmetics.UnlockAll.Refresh()
    if not Cosmetics.UnlockAll.Enabled then return end
    unlockSwords()
    unlockExplosions()
    unlockTitles()
    unlockEmotes()
end

Cosmetics.SwordChanger = {
    EquippedSword = nil,
    SwordController = nil,
    Connections = {}
}

local function getSwordSlashName(swordName)
    local sm = getSwordsModule()
    if sm then
        local ok, data = pcall(function() return sm:GetSword(swordName) end)
        if ok and type(data) == "table" and type(data.SlashName) == "string" and data.SlashName ~= "" then
            return data.SlashName
        end
    end
    return "SlashEffect"
end

local function visualRemoveOldSwordCompletely(oldSword)
    if type(oldSword) ~= "string" or oldSword == "" then return end
    local char = LocalPlayer.Character
    if not char then return end

    local swordKey = normalizeName(oldSword)
    for _, object in ipairs(char:GetChildren()) do
        if object.Name == oldSword or normalizeName(object.Name) == swordKey then
            if object:IsA("Model") or object:IsA("Folder") or object:IsA("BasePart") or object:IsA("Accessory") or object:IsA("Tool") then
                pcall(function() object:Destroy() end)
            end
        end
    end

    local controller = Cosmetics.SwordChanger.SwordController
    if controller then
        pcall(function()
            if controller.currentSword ~= nil then controller.currentSword = nil end
            if controller.SwordFX ~= nil then controller.SwordFX = nil end
        end)
    end
end

local swordFxHooked = {}
local function hookSwordFxRemote(remoteName)
    if not getconnections then return end
    local remotes = getRemotesFolder()
    local remote = remotes and remotes:FindFirstChild(remoteName)
    if not remote or not remote:IsA("RemoteEvent") then return end

    local ok, connections = pcall(getconnections, remote.OnClientEvent)
    if not ok or type(connections) ~= "table" then return end

    for _, connection in ipairs(connections) do
        local fn = connection.Function
        if fn and not swordFxHooked[fn] then
            swordFxHooked[fn] = true
            connection:Disable()
            local wrapper = function(...)
                local args = {...}
                local selectedSword = Cosmetics.SwordChanger.EquippedSword
                if selectedSword then
                    local isLocal = false
                    for _, arg in ipairs(args) do
                        if tostring(arg) == LocalPlayer.Name or arg == LocalPlayer or arg == LocalPlayer.Character then
                            isLocal = true
                            break
                        end
                    end
                    if isLocal then
                        local slashName = getSwordSlashName(selectedSword)
                        for index, arg in ipairs(args) do
                            if type(arg) == "string" then
                                if arg:find("Slash") or arg == "Default" or arg:find("Effect") then
                                    args[index] = slashName
                                elseif getSwordsModule() and getSwordsModule():GetSword(arg) then
                                    args[index] = selectedSword
                                end
                            end
                        end
                    end
                end
                pcall(fn, unpack(args))
            end
            swordFxHooked[wrapper] = true
            remote.OnClientEvent:Connect(wrapper)
        end
    end
end

local function installSwordHooks()
    for _, remoteName in ipairs({
        "ParrySuccessAll",
        "ParryAttempt",
        "ParrySuccess",
        "PlaySound",
        "PlayVisuals"
    }) do
        pcall(hookSwordFxRemote, remoteName)
    end
end

function Cosmetics.SwordChanger.Equip(swordName)
    if type(swordName) ~= "string" or swordName == "" then return false end
    local sm = getSwordsModule()
    if not sm or not sm:GetSword(swordName) then return false end

    local char = LocalPlayer.Character
    if not char then return false end

    if Cosmetics.SwordChanger.EquippedSword and Cosmetics.SwordChanger.EquippedSword ~= swordName then
        visualRemoveOldSwordCompletely(Cosmetics.SwordChanger.EquippedSword)
    end

    pcall(function()
        local equipFn = rawget(sm, "EquipSwordTo")
        if type(equipFn) == "function" and getupvalues and setupvalue then
            local ups = getupvalues(equipFn)
            for idx, val in ipairs(ups) do
                if type(val) == "boolean" then
                    setupvalue(equipFn, idx, false)
                    break
                end
            end
        end
        sm:EquipSwordTo(char, swordName)
    end)

    local remotes = getRemotesFolder()
    local fireSwordInfo = remotes and remotes:FindFirstChild("FireSwordInfo")
    if fireSwordInfo then
        pcall(function() fireSwordInfo:FireServer(swordName) end)
    end

    Cosmetics.SwordChanger.EquippedSword = swordName
    getgenv().__VISUAL_UNLOCK_ALL_OWNS_SWORD = true
    getgenv().__VISUAL_UNLOCK_ALL_SWORD = swordName
    getgenv().__VISUAL_UNLOCK_ALL_SLASH = getSwordSlashName(swordName)

    pcall(function()
        LocalPlayer:SetAttribute("CurrentlyEquippedSword", swordName)
        char:SetAttribute("CurrentlyEquippedSword", swordName)
    end)

    installSwordHooks()
    return true
end

Cosmetics.ExplosionChanger = {
    Enabled = false,
    SelectedExplosion = "Default",
    Connections = {}
}

local function findExplosionTemplate(name)
    local misc = ReplicatedStorage:FindFirstChild("Misc")
    local candidates = {}
    if misc then
        local de = misc:FindFirstChild("DataExplosions")
        if de then table.insert(candidates, de) end
        local ee = misc:FindFirstChild("ExplosionEffects")
        if ee then table.insert(candidates, ee) end
    end
    local shared = ReplicatedStorage:FindFirstChild("Shared")
    local repInst = shared and shared:FindFirstChild("ReplicatedInstances")
    if repInst then table.insert(candidates, repInst) end

    local wanted = normalizeName(name)
    for _, root in ipairs(candidates) do
        local exact = root:FindFirstChild(name, true)
        if exact then return exact end
        for _, child in ipairs(root:GetDescendants()) do
            if normalizeName(child.Name) == wanted then
                return child
            end
        end
    end
    return nil
end

local function activateExplosionVisual(root)
    if not root then return end
    for _, desc in ipairs(root:GetDescendants()) do
        if desc:IsA("ParticleEmitter") then
            desc.Enabled = true
            task.delay(0.2, function()
                pcall(function() desc.Enabled = false end)
            end)
        elseif desc:IsA("Sound") then
            pcall(function() desc:Play() end)
        elseif desc:IsA("PointLight") or desc:IsA("SpotLight") then
            desc.Enabled = true
            task.delay(0.3, function()
                pcall(function() desc.Enabled = false end)
            end)
        end
    end
    task.delay(4, function()
        pcall(function() root:Destroy() end)
    end)
end

function Cosmetics.ExplosionChanger.PlayLocalExplosion(position)
    if not position then
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        position = root and root.Position or Vector3.zero
    end

    local tmpl = findExplosionTemplate(Cosmetics.ExplosionChanger.SelectedExplosion)
    if tmpl then
        local clone = tmpl:Clone()
        local parent = workspace:FindFirstChild("Runtime") or workspace
        clone.Parent = parent
        if clone:IsA("BasePart") then
            clone.Position = position
            clone.Anchored = true
            clone.CanCollide = false
        elseif clone:IsA("Model") then
            clone:PivotTo(CFrame.new(position))
        end
        activateExplosionVisual(clone)
    end
end

function Cosmetics.ExplosionChanger.Set(name)
    Cosmetics.ExplosionChanger.SelectedExplosion = name
    getgenv().explosionFX = name

    pcall(function()
        LocalPlayer:SetAttribute("CurrentlyEquippedExplosion", name)
        LocalPlayer:SetAttribute("CurrentlyEquippedExplosionFX", name)
        LocalPlayer:SetAttribute("EquippedExplosion", name)
        LocalPlayer:SetAttribute("KillEffect", name)
    end)

    local char = LocalPlayer.Character
    if char then
        pcall(function()
            char:SetAttribute("CurrentlyEquippedExplosion", name)
            char:SetAttribute("CurrentlyEquippedExplosionFX", name)
            char:SetAttribute("EquippedExplosion", name)
            char:SetAttribute("KillEffect", name)
        end)
    end
end

function Cosmetics.ExplosionChanger.Test(position)
    Cosmetics.ExplosionChanger.PlayLocalExplosion(position)
end

function Cosmetics.ExplosionChanger.Toggle(state)
    Cosmetics.ExplosionChanger.Enabled = state == true
    if Cosmetics.ExplosionChanger.Enabled then
        Cosmetics.ExplosionChanger.Set(Cosmetics.ExplosionChanger.SelectedExplosion)
    end
end

function Cosmetics.GetSwords()
    local swords = {}
    local sm = getSwordsModule()
    if sm then
        local ok, collection = pcall(function() return sm:GetCollection() end)
        if ok and type(collection) == "table" then
            for key, sword in pairs(collection) do
                local name = type(sword) == "table" and sword.Name or (type(key) == "string" and key)
                if name and not table.find(swords, name) then
                    table.insert(swords, name)
                end
            end
        end
    end
    table.sort(swords)
    return swords
end

function Cosmetics.GetExplosions()
    local explosions = {}
    local misc = ReplicatedStorage:FindFirstChild("Misc")
    local de = misc and misc:FindFirstChild("DataExplosions")
    if de then
        for _, child in ipairs(de:GetChildren()) do
            if not table.find(explosions, child.Name) then
                table.insert(explosions, child.Name)
            end
        end
    end
    table.sort(explosions)
    return explosions
end

getgenv().Cosmetics = Cosmetics
return Cosmetics
