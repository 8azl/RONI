local swordFxHookedFunctions = {}

local function hookSwordFxRemote(remoteName)
    if not getconnections then
        return
    end

    local remote = Remotes:FindFirstChild(remoteName)
    if not remote or not remote:IsA("RemoteEvent") then
        return
    end

    local ok, connections = pcall(getconnections, remote.OnClientEvent)
    if not ok or type(connections) ~= "table" then
        return
    end

    for _, connection in ipairs(connections) do
        local targetFunction = connection.Function
        if targetFunction and not swordFxHookedFunctions[targetFunction] then
            swordFxHookedFunctions[targetFunction] = true

            local okName, functionName = pcall(function()
                return getinfo(targetFunction).name
            end)

            if okName and functionName then
                connection:Disable()

                local wrapper
                wrapper = function(...)
                    local args = {...}
                    local selectedSword = VisualNativeUnlockAll.EquippedSword

                    if selectedSword then
                        local localEvent = false
                        for _, arg in ipairs(args) do
                            if tostring(arg) == LocalPlayer.Name or arg == LocalPlayer or arg == LocalPlayer.Character then
                                localEvent = true
                                break
                            end
                        end

                        if localEvent then
                            local slashName = getSwordSlashName(selectedSword)
                            local replacedSlash = false
                            local replacedSword = false

                            for index, arg in ipairs(args) do
                                if type(arg) == "string" then
                                    if not replacedSlash and (arg:find("Slash") or arg == "Default" or arg:find("Effect")) then
                                        args[index] = slashName
                                        replacedSlash = true
                                    elseif not replacedSword and getSwordDataByName(arg) then
                                        args[index] = selectedSword
                                        replacedSword = true
                                    end
                                end
                            end
                        end
                    end

                    pcall(targetFunction, unpack(args))
                end

                swordFxHookedFunctions[wrapper] = true
                remote.OnClientEvent:Connect(wrapper)
            end
        end
    end
end

local function installSwordFxSfxHooks()
    for _, remoteName in ipairs({
        "ParrySuccessAll",
        "ParryAttempt",
        "ParrySuccess",
        "PlaySound",
        "PlayVisuals",
    }) do
        pcall(hookSwordFxRemote, remoteName)
    end
end

local function stateSet(state, value)
    if state and type(state.Set) == "function" then
        pcall(function()
            state:Set(value)
        end)
    end
end

local function forceOwned(item)
    if type(item) ~= "table" then
        return false
    end

    item.Hidden = false
    item.ForceHide = false
    item.AlwaysVisible = true
    item.Section = "Owned"

    stateSet(item.OwnsItem, true)

    if item.ItemsMatching and type(item.ItemsMatching.Set) == "function" then
        local current = {}
        pcall(function()
            current = item.ItemsMatching:Get() or {}
        end)

        if #current == 0 then
            stateSet(item.ItemsMatching, {
                "__visual_unlock_" .. tostring(item.Name)
            })
        end
    end

    return true
end

refreshInventoryPage = function(inventoryType)
    if not ShopController then
        return
    end

    local page = ShopController._inventoryPages and ShopController._inventoryPages[inventoryType]
    if not page then
        return
    end

    pcall(function()
        page.BeginBatch()
    end)

    local items = ShopController._virtualItems and ShopController._virtualItems[inventoryType]
    if items and page.MarkDirty then
        for _, item in pairs(items) do
            pcall(function()
                page.MarkDirty(item, true, true)
            end)
        end
        pcall(function()
            page.MarkDirty(nil, true, true)
        end)
    end

    pcall(function()
        page.EndBatch()
    end)
end

local function ensurePageLoaded(pageName)
    if not ShopController then
        return
    end

    if type(ShopController._loadInventoryPage) == "function" then
        pcall(function()
            ShopController._loadInventoryPage(pageName)
        end)
    end

    local deadline = os.clock() + 4
    while os.clock() < deadline do
        local page = ShopController._inventoryPages and ShopController._inventoryPages[pageName]
        local items = ShopController._virtualItems and ShopController._virtualItems[pageName]
        if page and items then
            break
        end
        task.wait(0.05)
    end
end

local function unlockSwords()
    if not ShopController or not Swords then
        return
    end

    ensurePageLoaded("Sword")

    ShopController._virtualItems = ShopController._virtualItems or {}
    ShopController._virtualItems.Sword = ShopController._virtualItems.Sword or {}

    deduplicateSwordSlots()

    local collection = Swords:GetCollection()
    local processedSwords = 0

    for key, sword in pairs(collection) do
        processedSwords += 1
        if processedSwords % 24 == 0 then
            task.wait()
        end

        if type(sword) == "table" then
            local swordName = sword.Name or (type(key) == "string" and key) or nil
            if swordName then
                local item = getExistingSwordItem(swordName)
                if not item and type(ShopController._createSwordSlot) == "function" then
                    pcall(function()
                        ShopController:_createSwordSlot(sword)
                    end)
                    item = getExistingSwordItem(swordName)
                end

                if item and forceOwned(item) then
                    VisualNativeUnlockAll.Stats.Swords += 1
                    applyFavoriteToNativeSwordItem(swordName, isSwordFavorited(swordName))
                    if tostring(sword.Rarity) == "Unique" then
                        VisualNativeUnlockAll.Stats.UniqueSwords += 1
                    end
                end
            end
        end
    end

    deduplicateSwordSlots()
    refreshInventoryPage("Sword")
end

local function unlockExplosions()
    if not ShopController then
        return
    end

    ensurePageLoaded("Explosion")

    local misc = ReplicatedStorage:FindFirstChild("Misc")
    local dataExplosions = misc and misc:FindFirstChild("DataExplosions")
    if not dataExplosions then
        return
    end

    ShopController._virtualItems = ShopController._virtualItems or {}
    ShopController._virtualItems.Explosion = ShopController._virtualItems.Explosion or {}

    for _, config in ipairs(dataExplosions:GetChildren()) do
        local item = ShopController._virtualItems.Explosion[config.Name]
        if not item and type(ShopController._createExplosionSlot) == "function" then
            local wasHidden = config:GetAttribute("Hidden") == true
            pcall(function()
                ShopController:_createExplosionSlot(config)
            end)
            item = ShopController._virtualItems.Explosion[config.Name]
            if item and wasHidden then
                VisualNativeUnlockAll.Stats.HiddenExplosionsCreated += 1
            end
        end

        if item and forceOwned(item) then
            VisualNativeUnlockAll.Stats.Explosions += 1
        end
    end

    refreshInventoryPage("Explosion")
end

