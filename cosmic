local function applyTitleToPlayerCard(info)
    if type(info) ~= "table" or not info.Tag then
        return
    end

    VisualNativeUnlockAll.SelectedTitle = info.Name

    local profileCard = PlayerGui:FindFirstChild("ProfileCard")
    local customize = profileCard and profileCard:FindFirstChild("Customize")
    local playerCard = customize and customize:FindFirstChild("PlayerCard")
    local title = playerCard and playerCard:FindFirstChild("Title")

    if title and title:IsA("TextLabel") then
        title.Text = info.Tag.Text or info.Name
        title.TextColor3 = info.Tag.Color or Color3.new(1, 1, 1)

        local stroke = title:FindFirstChildOfClass("UIStroke")
        if stroke then
            stroke.Color = info.Tag.Color or Color3.new(1, 1, 1)
        end
    end
end

local function getTitleRows()
    local rows = {}
    for _, object in ipairs(PlayerGui:GetDescendants()) do
        if object:IsA("GuiObject") then
            local parent = object.Parent
            local grand = parent and parent.Parent
            local inTitleList = (parent and parent.Name == "TitleList") or (grand and grand.Name == "TitleList")
            if inTitleList and object:FindFirstChild("TextLabel") then
                rows[#rows + 1] = object
            end
        end
    end
    return rows
end

