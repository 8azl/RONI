local function getSwordSlashName(swordName)
    local swordData = getSwordDataByName(swordName)
    if type(swordData) == "table" and type(swordData.SlashName) == "string" and swordData.SlashName ~= "" then
        return swordData.SlashName
    end
    return "SlashEffect"
end

local function visualRemoveOldSwordCompletely(oldSword)
    if type(oldSword) ~= "string" or oldSword == "" then
        return
    end

    local oldSlash = getSwordSlashName(oldSword)

    local function norm(v)
        return tostring(v or "")
            :lower()
            :gsub("[^%w]", "")
    end

    local swordKey = norm(oldSword)
    local slashKey = norm(oldSlash)

    local function matchesOldIdentity(object)
        if not object then
            return false
        end

        local nameKey = norm(object.Name)
        if swordKey ~= "" and nameKey:find(swordKey, 1, true) then
            return true
        end

        if slashKey ~= "" and slashKey ~= "slasheffect" and nameKey:find(slashKey, 1, true) then
            return true
        end

        for _, attr in ipairs({
            "Sword",
            "SwordName",
            "SwordFX",
            "Effect",
            "EffectName",
            "SlashName",
        }) do
            local value = object:GetAttribute(attr)
            if type(value) == "string" then
                local key = norm(value)
                if key == swordKey or (slashKey ~= "" and slashKey ~= "slasheffect" and key == slashKey) then
                    return true
                end
            end
        end

        return false
    end

    local character = LocalPlayer.Character
    if character then
        for _, object in ipairs(character:GetChildren()) do
            if object.Name == oldSword or matchesOldIdentity(object) then
                if object:IsA("Model") or object:IsA("Folder") or object:IsA("BasePart") or object:IsA("Accessory") or object:IsA("Tool") or object:IsA("Attachment") then
                    pcall(function()
                        object:Destroy()
                    end)
                end
            end
        end

        for _, object in ipairs(character:GetDescendants()) do
            if matchesOldIdentity(object) then
                if object:IsA("Sound") then
                    pcall(function()
                        object:Stop()
                        object.Playing = false
                        object:Destroy()
                    end)
                elseif object:IsA("ParticleEmitter") or object:IsA("Trail") or object:IsA("Beam") then
                    pcall(function()
                        object.Enabled = false
                        object:Destroy()
                    end)
                end
            end
        end
    end

    local runtime = workspace:FindFirstChild("Runtime")
    if runtime then
        for _, object in ipairs(runtime:GetDescendants()) do
            if matchesOldIdentity(object) then
                pcall(function()
                    if object:IsA("Sound") then
                        object:Stop()
                    elseif object:IsA("ParticleEmitter") or object:IsA("Trail") or object:IsA("Beam") then
                        object.Enabled = false
                    end
                    object:Destroy()
                end)
            end
        end
    end

    local controller = VisualNativeUnlockAll.SwordController
    if controller then
        pcall(function()
            if controller.currentSword ~= nil then
                controller.currentSword = nil
            end
        end)
        pcall(function()
            if controller.SwordFX ~= nil then
                controller.SwordFX = nil
            end
        end)
    end
end

local function visualRemoveCompetingSwords(character, desiredSword)
    if not character or type(desiredSword) ~= "string" or desiredSword == "" then
        return
    end

    local nativeCurrent = LocalPlayer:GetAttribute("CurrentlyEquippedSword")

    for _, object in ipairs(character:GetChildren()) do
        if object.Name ~= desiredSword then
            local isSwordObject = false

            if type(nativeCurrent) == "string" and nativeCurrent ~= "" and object.Name == nativeCurrent then
                isSwordObject = true
            end

            if not isSwordObject then
                local ok, swordData = pcall(function()
                    return Swords and Swords:GetSword(object.Name)
                end)
                if ok and swordData then
                    isSwordObject = true
                end
            end

            if isSwordObject and (object:IsA("Model") or object:IsA("Tool") or object:IsA("Accessory") or object:IsA("Folder")) then
                pcall(function()
                    object:Destroy()
                end)
            end
        end
    end
end

local function equipSwordLocally(swordName)
    if type(swordName) ~= "string" or swordName == "" then
        return false
    end

    local previousSword = VisualNativeUnlockAll.EquippedSword
    if previousSword and previousSword ~= "" and previousSword ~= swordName then
        visualRemoveOldSwordCompletely(previousSword)
    end

    local swordData = getSwordDataByName(swordName)
    if not swordData then
        return false
    end

    local character = LocalPlayer.Character
    if not character then
        return false
    end

    pcall(function()
        local equipFunction = rawget(Swords, "EquipSwordTo")
        if type(equipFunction) == "function" and getupvalues and setupvalue then
            local upvalues = getupvalues(equipFunction)
            for index, value in ipairs(upvalues) do
                if type(value) == "boolean" then
                    setupvalue(equipFunction, index, false)
                    break
                end
            end
        end
        Swords:EquipSwordTo(character, swordName)
    end)

    local controller = VisualNativeUnlockAll.SwordController or findSwordControllerOnce()
    if controller then
        pcall(function()
            if type(controller.SetSword) == "function" then
                controller:SetSword(swordName)
            end
        end)
        pcall(function()
            if controller.currentSword ~= nil then
                controller.currentSword = swordName
            end
        end)
        pcall(function()
            if controller.SwordFX ~= nil then
                controller.SwordFX = swordName
            end
        end)
    end

    local fireSwordInfo = Remotes:FindFirstChild("FireSwordInfo")
    if fireSwordInfo then
        pcall(function()
            fireSwordInfo:FireServer(swordName)
        end)
    end

    VisualNativeUnlockAll.SelectedSword = swordName
    VisualNativeUnlockAll.EquippedSword = swordName
    VisualNativeUnlockAll.PersistentSword = swordName

    getgenv().__VISUAL_UNLOCK_ALL_OWNS_SWORD = true
    getgenv().__VISUAL_UNLOCK_ALL_SWORD = swordName

    pcall(function()
        LocalPlayer:SetAttribute("CurrentlyEquippedSword", swordName)
    end)

    pcall(function()
        character:SetAttribute("CurrentlyEquippedSword", swordName)
    end)

    getgenv().__VISUAL_UNLOCK_ALL_SLASH = getSwordSlashName(swordName)
    return true
end

local function setButtonText(button, value)
    if not button then
        return
    end

    if button:IsA("GuiObject") then
        button.Visible = true
        button.Active = true
    end

    if button:IsA("TextButton") then
        button.Text = value
    end

    for _, object in ipairs(button:GetDescendants()) do
        if object:IsA("TextLabel") or object:IsA("TextButton") then
            local current = object.Text
            if current == "Buy" or current == "Equip" or current == "Equipped" or tostring(object.Name):lower():find("price", 1, true) or tostring(object.Name):lower():find("equip", 1, true) then
                object.Text = value
                object.Visible = true
            end
        end
    end
end

