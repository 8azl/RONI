    for row, info in pairs(hookedTitleRows) do
        if row and row.Parent then
            row.Visible = true
            local selected = row:FindFirstChild("Selected")
            if selected and selected:IsA("GuiObject") then
                selected.Visible = (VisualNativeUnlockAll.SelectedTitle == info.Name)
            end
        end
    end
end

local function unlockTitles()
    if type(TitleData) ~= "table" then
        return
    end

    local rows = getTitleRows()
    for _, row in ipairs(rows) do
        row.Visible = true
        local label = row:FindFirstChild("TextLabel")
        local info = label and titleByDisplayText(label.Text) or nil

        if info and not hookedTitleRows[row] then
            hookedTitleRows[row] = info
            VisualNativeUnlockAll.Stats.Titles += 1

            if row:IsA("GuiButton") then
                table.insert(
                    VisualNativeUnlockAll.Connections,
                    row.Activated:Connect(function()
                        if not VisualNativeUnlockAll.Enabled then
                            return
                        end
                        applyTitleToPlayerCard(info)
                        refreshTitleSelection()
                    end)
                )
            end
        end
    end

    refreshTitleSelection()
end

local visualEmoteCards = {}

local function clearVisualEmotes()
    for _, object in ipairs(visualEmoteCards) do
        if object and object.Parent then
            object:Destroy()
        end
    end
    table.clear(visualEmoteCards)
end

local function unlockEmotes()
    clearVisualEmotes()

    local misc = ReplicatedStorage:FindFirstChild("Misc")
    local emotes = misc and misc:FindFirstChild("Emotes")
    local wheel = PlayerGui:FindFirstChild("EmoteWheel")
    local list = wheel and wheel:FindFirstChild("List")
    local content = list and list:FindFirstChild("Content")
    local grid = content and content:FindFirstChild("UIGridLayout")
    local template = grid and grid:FindFirstChild("TEMPLATE")

    if not emotes or not content or not grid or not template then
        return
    end

    local existing = {}
    for _, child in ipairs(content:GetChildren()) do
        if child:IsA("GuiObject") and child ~= template and not child:GetAttribute("DemonicUnlockEmote") then
            local id = child:GetAttribute("EmoteId") or child:GetAttribute("ItemKey")
            if id then
                existing[tostring(id)] = true
            end

            local label = child:FindFirstChild("ItemName", true)
            if label and label:IsA("TextLabel") and label.Text ~= "" then
                existing[label.Text] = true
            end
        end
    end

    local nextOrder = 100000

    for _, config in ipairs(emotes:GetChildren()) do
        local internalName = config.Name
        local displayName = config:GetAttribute("EmoteName") or internalName

        if not existing[internalName] and not existing[displayName] then
            local clone = template:Clone()
            clone.Name = "DemonicUnlock_" .. internalName
            clone.Visible = true
            clone.LayoutOrder = nextOrder
            nextOrder += 1

            clone:SetAttribute("DemonicUnlockEmote", true)
            clone:SetAttribute("EmoteId", internalName)
            clone:SetAttribute("ItemKey", internalName)
            clone:SetAttribute("EmoteName", displayName)

            local itemName = clone:FindFirstChild("ItemName", true)
            if itemName and itemName:IsA("TextLabel") then
                itemName.Text = displayName
                itemName.Visible = true
            end

            local vector = clone:FindFirstChild("Vector", true)
            local icon = config:GetAttribute("Icon")
            if vector and (vector:IsA("ImageLabel") or vector:IsA("ImageButton")) then
                vector.Visible = true
                if icon then
                    vector.Image = tostring(icon)
                end
            end

            for _, object in ipairs(clone:GetDescendants()) do
                if object:IsA("GuiObject") then
                    local key = tostring(object.Name):lower()
                    if key == "delete" or key == "favorite" or key == "favoritedtemplate" or key == "lock" or key == "stack" or key == "finisher" or key == "swordaccessory" or key == "quantity" or key == "count" then
                        object.Visible = false
                    end
                end

                if (object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox")) and object ~= itemName then
                    local key = tostring(object.Name):lower()
                    if key == "title" or key:find("quantity", 1, true) or key:find("stack", 1, true) or key:find("count", 1, true) then
                        object.Text = ""
                        object.Visible = false
                    end
                end
            end

            clone.AnchorPoint = Vector2.new(0, 0)
            clone.Position = UDim2.fromOffset(0, 0)
            clone.Parent = content

            visualEmoteCards[#visualEmoteCards + 1] = clone
        end
    end

    local nativeCard = nil
    for _, child in ipairs(content:GetChildren()) do
        if child:IsA("GuiObject") and child ~= template and not child:GetAttribute("DemonicUnlockEmote") then
            nativeCard = child
            break
        end
    end

    if nativeCard then
        for _, clone in ipairs(visualEmoteCards) do
            if clone and clone.Parent then
                clone.Size = nativeCard.Size
            end
        end
    end

    if content:IsA("ScrollingFrame") then
        task.defer(function()
            if grid and grid.Parent then
                content.CanvasSize = UDim2.fromOffset(0, grid.AbsoluteContentSize.Y)
            end
        end)
    end
end

