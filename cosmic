if not VisualNativeUnlockAll._swordRespawnHooked then
    VisualNativeUnlockAll._swordRespawnHooked = true

    LocalPlayer.CharacterAdded:Connect(function(character)
        local swordName = VisualNativeUnlockAll.PersistentSword or getgenv().__VISUAL_UNLOCK_ALL_SWORD
        if not swordName or swordName == "" then
            return
        end

        task.spawn(function()
            pcall(function()
                LocalPlayer.CharacterAppearanceLoaded:Wait()
            end)

            if not VisualNativeUnlockAll.Enabled then
                return
            end

            local passes = {
                0.05,
                0.12,
                0.25,
                0.45,
                0.75,
                1.10,
                1.55,
                2.10,
            }

            for _, delayTime in ipairs(passes) do
                task.wait(delayTime)

                if not VisualNativeUnlockAll.Enabled or LocalPlayer.Character ~= character or not character.Parent then
                    return
                end

                VisualNativeUnlockAll.SelectedSword = swordName
                VisualNativeUnlockAll.EquippedSword = swordName
                VisualNativeUnlockAll.PersistentSword = swordName

                getgenv().__VISUAL_UNLOCK_ALL_OWNS_SWORD = true
                getgenv().__VISUAL_UNLOCK_ALL_SWORD = swordName

                visualRemoveCompetingSwords(character, swordName)

                pcall(function()
                    LocalPlayer:SetAttribute("CurrentlyEquippedSword", swordName)
                end)

                pcall(function()
                    character:SetAttribute("CurrentlyEquippedSword", swordName)
                end)

                pcall(equipSwordLocally, swordName)

                visualRemoveCompetingSwords(character, swordName)
            end
        end)
    end)
end

function VisualNativeUnlockAll.Enable()
    if VisualNativeUnlockAll.Enabled then
        return
    end

    VisualNativeUnlockAll.Enabled = true
    requireGameModules()

    task.spawn(function()
        if not VisualNativeUnlockAll.InventoryUnlocked then
            unlockSwords()
            unlockExplosions()
            unlockTitles()
            unlockEmotes()
            VisualNativeUnlockAll.InventoryUnlocked = true
        end

        hookShop()
        hookSwordDetailPanel()
        installSwordFxSfxHooks()
    end)
end

function VisualNativeUnlockAll.Refresh()
    if not VisualNativeUnlockAll.Enabled then
        return
    end

    if not VisualNativeUnlockAll.InventoryUnlocked then
        task.spawn(function()
            unlockSwords()
            unlockExplosions()
            unlockTitles()
            unlockEmotes()
            VisualNativeUnlockAll.InventoryUnlocked = true
        end)
    else
        reapplyShopUnlock()
    end
end

function VisualNativeUnlockAll.Disable()
    VisualNativeUnlockAll.Enabled = false
    getgenv().__VISUAL_UNLOCK_ALL_OWNS_SWORD = false

    for _, connection in ipairs(VisualNativeUnlockAll.Connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    table.clear(VisualNativeUnlockAll.Connections)
    clearVisualEmotes()
    destroyLocalEquipButton()
end

function VisualNativeUnlockAll.Toggle(state)
    getgenv().VisualUnlockAllEnabled = state
    if state then
        if VisualNativeUnlockAll.Enabled then
            VisualNativeUnlockAll.Refresh()
        else
            VisualNativeUnlockAll.Enable()
        end
    else
        VisualNativeUnlockAll.Disable()
    end
end

function VisualNativeUnlockAll.Equip(swordName)
    return equipSwordLocally(swordName)
end

