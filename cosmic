local function findSwordControllerOnce()
    if VisualNativeUnlockAll.SwordController then
        return VisualNativeUnlockAll.SwordController
    end

    if VisualNativeUnlockAll.SwordControllerSearched then
        return nil
    end

    VisualNativeUnlockAll.SwordControllerSearched = true

    local fireSwordInfo = Remotes:FindFirstChild("FireSwordInfo")
    if not fireSwordInfo or not getconnections then
        return nil
    end

    local ok, connections = pcall(getconnections, fireSwordInfo.OnClientEvent)
    if not ok or type(connections) ~= "table" then
        return nil
    end

    for _, connection in ipairs(connections) do
        local fn = connection.Function
        if fn and islclosure and islclosure(fn) then
            local okUpvalues, upvalues = pcall(getupvalues, fn)
            if okUpvalues and type(upvalues) == "table" and #upvalues == 1 and type(upvalues[1]) == "table" then
                VisualNativeUnlockAll.SwordController = upvalues[1]
                return VisualNativeUnlockAll.SwordController
            end
        end
    end

    return nil
end

local function getSwordDataByName(swordName)
    if not Swords or type(swordName) ~= "string" then
