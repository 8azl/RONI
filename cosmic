local function matchesSwordName(item, swordName)
    if type(item) ~= "table" or type(swordName) ~= "string" then
        return false
    end
    if item.Name == swordName or item.ItemName == swordName or item.SwordName == swordName then
        return true
    end
    if type(item.Config) == "table" and item.Config.Name == swordName then
        return true
    end
    if type(item.Sword) == "table" and item.Sword.Name == swordName then
        return true
    end
    if type(item.Data) == "table" and item.Data.Name == swordName then
        return true
    end
    if type(item.Item) == "table" and item.Item.Name == swordName then
        return true
    end
    return false
end

local function getExistingSwordItem(swordName)
    if not ShopController or not ShopController._virtualItems or not ShopController._virtualItems.Sword then
        return nil
    end
    local swordTable = ShopController._virtualItems.Sword
    if swordTable[swordName] and matchesSwordName(swordTable[swordName], swordName) then
        return swordTable[swordName]
    end
    for _, item in pairs(swordTable) do
        if matchesSwordName(item, swordName) then
            return item
        end
    end
    if swordTable[swordName] and type(swordTable[swordName]) == "table" then
        return swordTable[swordName]
    end
    return nil
end

local function deduplicateSwordSlots()
    if not ShopController or not ShopController._virtualItems or not ShopController._virtualItems.Sword then
        return
    end
    local swordTable = ShopController._virtualItems.Sword
    local page = ShopController._inventoryPages and ShopController._inventoryPages.Sword
    local seen = {}
    local duplicates = {}

    for key, item in pairs(swordTable) do
        if type(item) == "table" then
            local name = item.Name or (item.Config and item.Config.Name) or (item.Sword and item.Sword.Name) or (item.Data and item.Data.Name) or (type(key) == "string" and key)
            if name then
                if not seen[name] then
                    seen[name] = { key = key, item = item }
                else
                    local existing = seen[name]
                    local existingIsReal = (existing.item.InventoryKey ~= nil) or (existing.item.UserItemId ~= nil) or (existing.item.Serial ~= nil) or (existing.key ~= name)
                    local currentIsReal = (item.InventoryKey ~= nil) or (item.UserItemId ~= nil) or (item.Serial ~= nil) or (key ~= name)
                    if currentIsReal and not existingIsReal then
                        duplicates[existing.key] = existing.item
                        seen[name] = { key = key, item = item }
                    else
                        duplicates[key] = item
                    end
                end
            end
        end
    end

    for dupKey, dupItem in pairs(duplicates) do
        swordTable[dupKey] = nil
        if page and type(page.MarkDirty) == "function" then
            pcall(function()
                page.MarkDirty(dupItem, false, true)
            end)
        end
    end
end

